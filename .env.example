# Local development values only. Replace the password placeholder in your untracked .env file.
# Do not use these sample values in a deployed environment.
GTA6RP_API_BASE_URL=http://127.0.0.1:8080/api/v1
RUST_LOG=info

# Local development only: replace this placeholder with a local password.
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgres://gta6rp:replace-this-local-password@127.0.0.1:54329/gta6rp
DATABASE_URL_TEST=postgres://gta6rp:replace-this-local-password@127.0.0.1:54330/gta6rp_test

# API settings. The API reads process environment variables directly.
API_BIND_ADDR=127.0.0.1:8080
API_ALLOWED_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_SECOND=5
API_RATE_LIMIT_BURST=20

